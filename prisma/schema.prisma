generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum StockAdjustmentType {
  INCREASE
  DECREASE
}

enum StockAdjustmentReason {
  MISSING
  FOUND
  MISPLACED
  COUNTING_ERROR
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id          String   @id @default(cuid())
  /**
   * Editable after creation — invoices keep their own frozen snapshot, so renaming/recoding a product never rewrites history.
   */
  code        String   @unique
  /**
   * Editable after creation — invoices keep their own frozen snapshot, so renaming/recoding a product never rewrites history.
   */
  name        String
  /**
   * The unit in which this product is stocked and sold, such as piece, box, or metre.
   */
  unit        String?
  /**
   * Optional clarification for the unit, such as "box of 100" or "5m roll".
   */
  unitDetail  String?  @map("unit_detail")
  /**
   * Cost of the most recent restock batch — denormalized for quick display.
   */
  currentCost Decimal  @default(0) @map("current_cost") @db.Decimal(12, 2)
  /**
   * Live running quantity in the warehouse.
   */
  stock       Int      @default(0)
  /**
   * Hide from pickers without losing invoice history.
   */
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  restocks     ProductRestock[]
  stockAdjustments ProductStockAdjustment[]
  clientPrices ClientProductPrice[]
  invoiceItems InvoiceItem[]
  draftItems   InvoiceDraftItem[]

  @@index([isActive])
  @@map("products")
}

/**
 * One row per purchase batch — the cost/quantity history behind Product.currentCost and Product.stock.
 */
model ProductRestock {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  costPerUnit Decimal  @map("cost_per_unit") @db.Decimal(12, 2)
  purchasedAt DateTime @default(now()) @map("purchased_at")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_restocks")
}

/**
 * A non-purchase correction to live stock, recorded separately from restock batches.
 */
model ProductStockAdjustment {
  id        String                @id @default(cuid())
  productId String                @map("product_id")
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockAdjustmentType
  quantity  Int
  reason    StockAdjustmentReason
  note      String?
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_stock_adjustments")
}

model Client {
  id        String   @id @default(cuid())
  /**
   * Set once at creation, never edited afterward.
   */
  code      String   @unique
  /**
   * May change over time.
   */
  name      String
  phone     String?
  email     String?
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productPrices ClientProductPrice[]
  invoices      Invoice[]
  invoiceDrafts InvoiceDraft[]

  @@index([isActive])
  @@map("clients")
}

/**
 * The client's current price for a product — editable directly, and kept fresh by whatever price was last used on an invoice.
 */
model ClientProductPrice {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, productId])
  @@index([clientId])
  @@map("client_product_prices")
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique @map("invoice_number")
  clientId           String        @map("client_id")
  client             Client        @relation(fields: [clientId], references: [id])
  /**
   * Client's name at the time of sale — frozen even if the client is later renamed.
   */
  clientNameSnapshot String        @map("client_name_snapshot")
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  items      InvoiceItem[]
  creditNote CreditNote?

  @@index([clientId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("invoices")
}

/**
 * A full reversal of one invoice. The original invoice is preserved for audit,
 * while this record returns its quantities to stock and removes it from sales totals.
 */
model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String   @unique @map("credit_note_number")
  invoiceId        String   @unique @map("invoice_id")
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount           Decimal  @db.Decimal(12, 2)
  reason           String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("credit_notes")
}

model InvoiceItem {
  id                  String  @id @default(cuid())
  invoiceId           String  @map("invoice_id")
  invoice             Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId           String  @map("product_id")
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCodeSnapshot String  @map("product_code_snapshot")
  productNameSnapshot String  @map("product_name_snapshot")
  /**
   * Unit and its detail at the time of sale — frozen like the name, so editing a product's unit never rewrites old invoices.
   */
  unitSnapshot        String? @map("unit_snapshot")
  unitDetailSnapshot  String? @map("unit_detail_snapshot")
  /**
   * Price per unit.
   */
  price               Decimal @db.Decimal(12, 2)
  quantity            Int
  total               Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

/**
 * A saved-for-later order. Not an invoice: no stock is reserved and it never counts toward sales,
 * so unlike invoices it can be edited and deleted freely.
 */
model InvoiceDraft {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items InvoiceDraftItem[]

  @@index([clientId])
  @@index([updatedAt])
  @@map("invoice_drafts")
}

model InvoiceDraftItem {
  id        String       @id @default(cuid())
  draftId   String       @map("draft_id")
  draft     InvoiceDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  productId String       @map("product_id")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  /**
   * Price when the draft was saved; the order form re-applies the client's current price when reopened.
   */
  price     Decimal      @db.Decimal(12, 2)

  @@index([draftId])
  @@index([productId])
  @@map("invoice_draft_items")
}
