generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Same as DATABASE_URL on local Postgres. On Neon: pooled URL in DATABASE_URL, unpooled (non-pooler host) here for migrations.
  directUrl = env("DIRECT_URL")
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id          String   @id @default(cuid())
  /**
   * Editable after creation — invoices keep their own frozen snapshot, so renaming/recoding a product never rewrites history.
   */
  code        String   @unique
  /**
   * Editable after creation — invoices keep their own frozen snapshot, so renaming/recoding a product never rewrites history.
   */
  name        String
  /**
   * Cost of the most recent restock batch — denormalized for quick display.
   */
  currentCost Decimal  @default(0) @map("current_cost") @db.Decimal(12, 2)
  /**
   * Live running quantity in the warehouse.
   */
  stock       Int      @default(0)
  /**
   * Hide from pickers without losing invoice history.
   */
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  restocks     ProductRestock[]
  clientPrices ClientProductPrice[]
  invoiceItems InvoiceItem[]

  @@index([isActive])
  @@map("products")
}

/**
 * One row per purchase batch — the cost/quantity history behind Product.currentCost and Product.stock.
 */
model ProductRestock {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  costPerUnit Decimal  @map("cost_per_unit") @db.Decimal(12, 2)
  purchasedAt DateTime @default(now()) @map("purchased_at")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_restocks")
}

model Client {
  id        String   @id @default(cuid())
  /**
   * Set once at creation, never edited afterward.
   */
  code      String   @unique
  /**
   * May change over time.
   */
  name      String
  phone     String?
  email     String?
  address   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productPrices ClientProductPrice[]
  invoices      Invoice[]

  @@index([isActive])
  @@map("clients")
}

/**
 * The client's current price for a product — editable directly, and kept fresh by whatever price was last used on an invoice.
 */
model ClientProductPrice {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([clientId, productId])
  @@index([clientId])
  @@map("client_product_prices")
}

model Invoice {
  id                 String        @id @default(cuid())
  invoiceNumber      String        @unique @map("invoice_number")
  clientId           String        @map("client_id")
  client             Client        @relation(fields: [clientId], references: [id])
  /**
   * Client's name at the time of sale — frozen even if the client is later renamed.
   */
  clientNameSnapshot String        @map("client_name_snapshot")
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  items InvoiceItem[]

  @@index([clientId])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id                  String  @id @default(cuid())
  invoiceId           String  @map("invoice_id")
  invoice             Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId           String  @map("product_id")
  product             Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productCodeSnapshot String  @map("product_code_snapshot")
  productNameSnapshot String  @map("product_name_snapshot")
  price               Decimal @db.Decimal(12, 2)
  quantity            Int
  total               Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}
